# Copy this file to .env (local dev) and to your hosting provider's
# environment variables panel (production). Never commit the real .env file.

# Public site URL — used for canonical links, Open Graph tags, JSON-LD, and sitemap.
VITE_SITE_URL=https://shipzivora.in

# WhatsApp Business number in international format, digits only, no "+" or spaces.
VITE_WHATSAPP_NUMBER=917678580743

# Concierge/support inbox shown on the Contact page and footer.
VITE_CONTACT_EMAIL=shipzivora@gmail.com

# Social profile URLs shown in the footer and Contact page.
VITE_INSTAGRAM_URL=https://instagram.com/shipzivora
VITE_FACEBOOK_URL=https://facebook.com/shipzivora
